---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const authors = getAllAuthors(allPosts);
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.name} — what it publishes and who writes it.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">About</p>
        <h1 class="pagehead-title">{siteConfig.name}</h1>
        <p class="pagehead-description">{siteConfig.about}</p>
      </header>

      <div class="prose">
        <h2>About This Site</h2>
        <p><strong>Stats on a Stick</strong> is an exploration of the numbers and stories behind the <a href="https://www.mnstatefair.org/">Minnesota State Fair</a>.</p>
        <p>Not officially afilliated with Fair.</p>

        <h2>Who writes it</h2>
        <ul>
          {
            authors.map((author) => (
              <li>
                <a href={`/author/${authorSlug(author.name)}/`}>{author.name}</a> — {author.role} ({author.posts.length} {author.posts.length === 1 ? "post" : "posts"})
              </li>
            ))
          }
        </ul>
        <h3>Brought to You By</h3>
        <ul>
          <li><a href="https://catalystics.co" target="_blank">Catalystics LLC</a></li>
          <li><a href="https://zessmanresearch.com" target="_blank">Zessman Research LLC</a></li>
        </ul>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
